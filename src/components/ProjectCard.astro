---
import { Image } from 'astro:assets';
import type { Project } from '../features/portfolio/data';
import { projectKinds, projectPath } from '../features/portfolio/routes';

interface Props {
  project: Project;
  heading?: 'h2' | 'h3';
}
const { project, heading: Heading = 'h3' } = Astro.props;
const metric = project.results[0];
---
<article class="project-card" data-project-card data-categories={project.categories.join(' ')}>
  <a class="card-link" href={projectPath(project.slug)}>
    <div class="card-body">
      <span class:list={['kind', 'kind-' + project.kind]}>{projectKinds[project.kind]}</span>
      <Heading>{project.shortTitle ?? project.title}</Heading>
      <p class="card-summary">{project.summary}</p>
      {metric && <p class="card-metric"><strong>{metric.value}</strong> {metric.label}</p>}
    </div>
    {project.cover
      ? <div class="card-thumb" data-media>
          <Image src={project.cover.image} alt="" widths={[144, 216]} sizes="72px" />
        </div>
      : <span class="card-chevron" aria-hidden="true"></span>}
  </a>
</article>
