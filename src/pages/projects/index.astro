---
import SiteLayout from '../../layouts/SiteLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Share from '../../components/Share.astro';
import { publishedProjects } from '../../features/portfolio/data';
import { catalogPath, categories, type Category } from '../../features/portfolio/routes';

const projects = await publishedProjects();
const filters = (Object.keys(categories) as Category[])
  .filter((category) => projects.some((project) => project.categories.includes(category)));
---
<SiteLayout title="Кейсы" description="Реальные проекты, типовые сценарии и интерактивные демо." page="projects" canonicalPath={catalogPath()}>
  <div class="page-heading">
    <h1>Кейсы</h1>
    <p>Реальные проекты, типовые сценарии и демо.</p>
  </div>
  <section class="catalog" aria-label="Каталог проектов" data-catalog>
    <nav aria-label="Категории проектов">
      <ul class="filters">
        <li><a href={catalogPath()} aria-current="true" data-category="">Все</a></li>
        {filters.map((category) => <li><a href={catalogPath(category)} data-category={category}>{categories[category]}</a></li>)}
      </ul>
    </nav>
    <div class="catalog-meta">
      <p class="muted" role="status" data-catalog-count></p>
      <Share kind="category" />
    </div>
    <p class="notice" role="status" data-link-error hidden>Проект или подборка недоступны. Ниже все опубликованные работы.</p>
    {projects.length > 0 && <div class="project-grid" data-project-grid>{projects.map((project) => <ProjectCard project={project} heading="h2" />)}</div>}
    <div data-empty-catalog hidden={projects.length > 0}>
      <EmptyState title="Пока нет опубликованных проектов" />
    </div>
    <div data-empty-category hidden>
      <EmptyState title="В этой категории пока нет проектов" href={catalogPath()} linkLabel="Показать все проекты" />
    </div>
  </section>
</SiteLayout>
