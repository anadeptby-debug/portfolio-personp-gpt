---
import { getImage, Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Share from '../../components/Share.astro';
import { publishedProjects, profile, relatedProjects, type Project } from '../../features/portfolio/data';
import { catalogPath, projectKinds, projectPath, projectVideoPath, withBase } from '../../features/portfolio/routes';
import { telegramContact } from '../../features/sharing/links';

export const getStaticPaths = (async () => {
  const projects = await publishedProjects();
  return projects.flatMap((project) => [project.slug, ...project.aliases].map((slug) => ({
    params: { slug },
    props: { project, related: relatedProjects(project, projects) },
  })));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  related: Project[];
}
const { project, related } = Astro.props;
const canonicalPath = projectPath(project.slug);
const isAlias = Astro.params.slug !== project.slug;
const previewImage = project.cover && !isAlias
  ? { src: (await getImage({ src: project.cover.image, width: 1200, format: 'jpeg' })).src, alt: project.cover.alt }
  : undefined;
const gallery = isAlias ? [] : await Promise.all(project.gallery.map(async (entry) => ({
  ...entry,
  full: await getImage({ src: entry.image, width: Math.min(entry.image.width, 1600), format: 'webp' }),
})));
const contact = telegramContact(profile.telegramUsername);
const video = project.video;
const videoSrc = video && ('asset' in video ? projectVideoPath(project.slug, video.asset) : withBase(video.src));
const demoHref = project.demoUrl && withBase(project.demoUrl);
const [solutionLead = '', ...solutionRest] = project.solution.split(/\n\s*\n/).map((part) => part.trim()).filter(Boolean);
const demoExternal = !!project.demoUrl && !project.demoUrl.startsWith('/');
const videoPoster = video?.poster && !isAlias
  ? (await getImage({ src: video.poster, width: Math.min(video.poster.width, 1000), format: 'webp' })).src
  : previewImage?.src;
---
{isAlias
  ? <SiteLayout title={project.title} description={project.summary} page="alias" canonicalPath={canonicalPath} noindex>
      <meta slot="head" http-equiv="refresh" content={'0;url=' + canonicalPath} />
      <div class="page-heading" data-case-alias={canonicalPath}><h1>{project.title}</h1>
        <a class="button button-primary" href={canonicalPath}>Открыть проект</a>
      </div>
    </SiteLayout>
  : <SiteLayout title={project.title} description={project.summary} page="case" canonicalPath={canonicalPath} previewImage={previewImage}>
      <article class="case-page">
        <div class="case-topline">
          <a class="text-link return-link" href={catalogPath()} data-case-back>Все проекты</a>
          <Share kind="case" value={project.slug} />
        </div>
        <header class="case-heading">
          <span class:list={['kind', 'kind-' + project.kind]}>{projectKinds[project.kind]}</span>
          <h1>{project.title}</h1>
          {project.context && <p class="case-context">{project.context}</p>}
          <p class="lead">{project.summary}</p>
          {(project.demoUrl || project.repositoryUrl) && <div class="actions">
            {project.demoUrl && <a class="button button-primary button-arrow" href={demoHref} target={demoExternal ? '_blank' : undefined} rel={demoExternal ? 'noopener noreferrer' : undefined}>Открыть демо</a>}
            {project.repositoryUrl && <a class="button button-secondary" href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">Исходный код</a>}
          </div>}
        </header>

        {project.results.length > 0 && <section class="results-section" aria-labelledby="case-results">
          <h2 id="case-results" class="visually-hidden">Результаты</h2>
          <dl class="stats">
            {project.results.map(({ label, value }) => <div class="stat"><dt>{label}</dt><dd>{value}</dd></div>)}
          </dl>
        </section>}

        {project.cover && <div class="case-cover" data-media>
          <Image src={project.cover.image} alt={project.cover.alt} widths={[480, 768, 1100]} sizes="(min-width: 46rem) 672px, 94vw" loading="eager" fetchpriority="high" />
        </div>}

        <div class="case-story">
          <section class="group" aria-labelledby="case-problem">
            <div class="group-head"><h2 id="case-problem">Задача</h2></div>
            <div class="group-body"><p class="long-copy">{project.problem}</p></div>
          </section>

          <section class="group" aria-labelledby="case-solution">
            <div class="group-head"><h2 id="case-solution">Решение</h2></div>
            <div class="group-body">
              <p class="long-copy">{solutionLead}</p>
              {solutionRest.length > 0 && <details class="more">
                <summary>Подробнее</summary>
                {solutionRest.map((paragraph) => <p class="long-copy">{paragraph}</p>)}
              </details>}
            </div>
          </section>

          {project.comparison.length > 0 && <section class="group" aria-labelledby="case-compare">
            <div class="group-head"><h2 id="case-compare">Было → стало</h2></div>
            <ul class="cells">
              {project.comparison.map(({ label, before, after }) => <li class="compare-cell">
                <span class="compare-label">{label}</span>
                <span class="compare-values">
                  <span class="compare-before">{before}</span>
                  <span class="compare-arrow" aria-label="стало">→</span>
                  <span class="compare-after">{after}</span>
                </span>
              </li>)}
            </ul>
          </section>}

          <section class="group" aria-labelledby="case-features">
            <div class="group-head"><h2 id="case-features">Возможности</h2></div>
            <ul class="cells">
              {project.features.map((feature) => <li class="cell feature-cell"><span class="cell-body">{feature}</span></li>)}
            </ul>
          </section>

          {project.fit && <section class="group" aria-labelledby="case-fit">
            <div class="group-head"><h2 id="case-fit">Кому подойдёт</h2></div>
            <div class="group-body"><p>{project.fit}</p></div>
          </section>}
        </div>

        {gallery.length > 0 && <section class="group" aria-labelledby="case-gallery">
          <div class="group-head"><h2 id="case-gallery">Скриншоты</h2></div>
          <div class="gallery-grid">
            {gallery.map(({ image, alt, full }) => <figure>
              <a href={full.src} data-gallery-link aria-label={'Увеличить: ' + alt} data-alt={alt} data-media>
                <Image src={image} alt={alt} widths={[360, 600]} sizes="18rem" />
              </a>
              <figcaption>{alt}</figcaption>
            </figure>)}
          </div>
          <dialog class="lightbox" aria-label="Просмотр скриншота" data-gallery-dialog>
            <div class="lightbox-content">
              <button type="button" class="button button-secondary button-small" data-gallery-close autofocus>Закрыть</button>
              <img alt="" data-gallery-image hidden />
              <p class="notice" data-gallery-error hidden>Не удалось загрузить изображение.</p>
            </div>
          </dialog>
        </section>}

        {video && videoSrc && <section class="group" aria-labelledby="case-video">
          <div class="group-head"><h2 id="case-video">Видео работы</h2></div>
          <div class:list={['case-video', { 'case-video-portrait': video.orientation === 'portrait' }]} data-media>
            <video controls playsinline preload="none" poster={videoPoster} data-video-src={videoSrc} aria-label="Видео работы проекта" hidden>
              {video.captions && <track kind="captions" src={withBase(video.captions)} srclang="ru" label="Русский" />}
            </video>
            <noscript><a class="text-link" href={videoSrc}>Открыть видео</a></noscript>
            <p class="notice media-error" hidden>Видео недоступно.</p>
          </div>
        </section>}

        {project.technologies.length > 0 && <section class="group" aria-labelledby="case-tech">
          <div class="group-head"><h2 id="case-tech">На чём сделано</h2></div>
          <ul class="tags">{project.technologies.map((technology) => <li>{technology}</li>)}</ul>
        </section>}

        {contact && <section class="group case-contact" aria-label="Связаться">
          <ul class="cells">
            <li><a class="cell" href={contact} data-telegram-contact>
              <span class="cell-icon" aria-hidden="true">✈</span>
              <span class="cell-body"><span class="cell-title">Обсудить похожий проект</span><span class="cell-sub">Ответим в Telegram</span></span>
            </a></li>
          </ul>
        </section>}
      </article>
      {related.length > 0 && <section class="group" aria-labelledby="case-related">
        <div class="group-head"><h2 id="case-related">Похожие проекты</h2></div>
        <div class="project-grid">{related.map((entry) => <ProjectCard project={entry} />)}</div>
      </section>}
    </SiteLayout>}
