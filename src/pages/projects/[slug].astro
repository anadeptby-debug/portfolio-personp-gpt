---
import { getImage, Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Share from '../../components/Share.astro';
import { publishedProjects, profile, relatedProjects, type Project } from '../../features/portfolio/data';
import { catalogPath, categories, projectKinds, projectPath, projectVideoPath } from '../../features/portfolio/routes';
import { telegramContact } from '../../features/sharing/links';

export const getStaticPaths = (async () => {
  const projects = await publishedProjects();
  return projects.flatMap((project) => [project.slug, ...project.aliases].map((slug) => ({
    params: { slug },
    props: { project, related: relatedProjects(project, projects) },
  })));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  related: Project[];
}
const { project, related } = Astro.props;
const canonicalPath = projectPath(project.slug);
const isAlias = Astro.params.slug !== project.slug;
const previewImage = project.cover && !isAlias
  ? { src: (await getImage({ src: project.cover.image, width: 1200, format: 'jpeg' })).src, alt: project.cover.alt }
  : undefined;
const gallery = isAlias ? [] : await Promise.all(project.gallery.map(async (entry) => ({
  ...entry,
  full: await getImage({ src: entry.image, width: Math.min(entry.image.width, 1600), format: 'webp' }),
})));
const contact = telegramContact(profile.telegramUsername);
const video = project.video;
const videoSrc = video && ('asset' in video ? projectVideoPath(project.slug, video.asset) : video.src);
const videoPoster = video?.poster && !isAlias
  ? (await getImage({ src: video.poster, width: Math.min(video.poster.width, 1000), format: 'webp' })).src
  : previewImage?.src;
---
{isAlias
  ? <SiteLayout title={project.title} description={project.summary} page="alias" canonicalPath={canonicalPath} noindex>
      <meta slot="head" http-equiv="refresh" content={'0;url=' + canonicalPath} />
      <div class="page-heading" data-case-alias={canonicalPath}><h1>{project.title}</h1>
        <a class="button button-primary" href={canonicalPath}>Открыть проект</a>
      </div>
    </SiteLayout>
  : <SiteLayout title={project.title} description={project.summary} page="case" canonicalPath={canonicalPath} previewImage={previewImage}>
      <article class="case-page">
        <div class="case-topline">
          <a class="text-link return-link" href="/projects" data-case-back>Все проекты</a>
          <Share kind="case" value={project.slug} />
        </div>
        <header class="case-heading">
          <span class:list={['kind-badge', 'kind-' + project.kind]}>{projectKinds[project.kind]}</span>
          <h1>{project.title}</h1>
          {project.context && <p class="case-context">{project.context}</p>}
          <p class="lead">{project.summary}</p>
          <ul class="filters case-categories" aria-label="Направления проекта">
            {project.categories.map((category) => <li><a href={catalogPath(category)}>{categories[category]}</a></li>)}
          </ul>
          {(project.demoUrl || project.repositoryUrl) && <div class="actions">
            {project.demoUrl && <a class="button button-primary button-arrow" href={project.demoUrl} target={project.demoUrl.startsWith('/') ? undefined : '_blank'} rel={project.demoUrl.startsWith('/') ? undefined : 'noopener noreferrer'}>Открыть демо</a>}
            {project.repositoryUrl && <a class="button button-secondary" href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">Исходный код</a>}
          </div>}
          {(gallery.length > 0 || project.video) && <div class="actions">
            {gallery.length > 0 && <a class="text-link" href="#case-gallery">К скриншотам</a>}
            {project.video && <a class="text-link" href="#case-video">К видео</a>}
          </div>}
        </header>
        {project.results.length > 0 && <section class="results-section" aria-labelledby="case-results">
          <h2 id="case-results" class="visually-hidden">Результаты</h2>
          <dl class="metrics metrics-large">
            {project.results.map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
          </dl>
        </section>}
        {project.cover && <div class="case-cover" data-media>
          <Image src={project.cover.image} alt={project.cover.alt} widths={[480, 768, 1100, 1500]} sizes="(min-width: 76rem) 1184px, 96vw" loading="eager" fetchpriority="high" />
        </div>}
        <div class="case-story">
          <section aria-labelledby="case-problem">
            <h2 id="case-problem">Задача</h2><p class="long-copy">{project.problem}</p>
          </section>
          <section aria-labelledby="case-solution">
            <h2 id="case-solution">Решение</h2><p class="long-copy">{project.solution}</p>
          </section>
          <section aria-labelledby="case-features">
            <h2 id="case-features">Возможности</h2>
            <ul class="feature-list">{project.features.map((feature) => <li>{feature}</li>)}</ul>
          </section>
          {project.comparison.length > 0 && <section aria-labelledby="case-compare">
            <h2 id="case-compare">Было → стало</h2>
            <ul class="compare">
              {project.comparison.map(({ label, before, after }) => <li>
                <span class="compare-label">{label}</span>
                <span class="compare-values">
                  <span class="compare-before"><span>Было</span> {before}</span>
                  <span class="compare-after"><span>Стало</span> {after}</span>
                </span>
              </li>)}
            </ul>
          </section>}
          {project.fit && <section class="case-fit" aria-labelledby="case-fit">
            <h2 id="case-fit">Кому подойдёт</h2>
            <p>{project.fit}</p>
          </section>}
          {project.technologies.length > 0 && <section aria-labelledby="case-tech">
            <h2 id="case-tech">На чём сделано</h2>
            <ul class="tags">{project.technologies.map((technology) => <li>{technology}</li>)}</ul>
          </section>}
        </div>

        {gallery.length > 0 && <section class="section" aria-labelledby="case-gallery">
          <div class="section-head"><h2 id="case-gallery">Скриншоты</h2></div>
          <div class="gallery-grid">
            {gallery.map(({ image, alt, full }) => <figure>
              <a href={full.src} data-gallery-link aria-label={'Увеличить: ' + alt} data-alt={alt} data-media>
                <Image src={image} alt={alt} widths={[360, 600, 900]} sizes="(min-width: 48rem) 45vw, 94vw" />
              </a>
              <figcaption>{alt}</figcaption>
            </figure>)}
          </div>
          <dialog class="lightbox" aria-label="Просмотр скриншота" data-gallery-dialog>
            <div class="lightbox-content">
              <button type="button" class="button button-secondary" data-gallery-close autofocus>Закрыть</button>
              <img alt="" data-gallery-image hidden />
              <p class="notice" data-gallery-error hidden>Не удалось загрузить изображение.</p>
            </div>
          </dialog>
        </section>}

        {video && videoSrc && <section class="section" aria-labelledby="case-video">
          <div class="section-head"><h2 id="case-video">Видео работы</h2></div>
          <div class:list={['case-video', { 'case-video-portrait': video.orientation === 'portrait' }]} data-media>
            <video controls playsinline preload="none" poster={videoPoster} data-video-src={videoSrc} aria-label="Видео работы проекта" hidden>
              {video.captions && <track kind="captions" src={video.captions} srclang="ru" label="Русский" />}
            </video>
            <noscript><a class="text-link" href={videoSrc}>Открыть видео</a></noscript>
            <p class="notice media-error" hidden>Видео недоступно.</p>
          </div>
        </section>}

        {contact && <div class="case-contact cta-panel">
          <div>
            <h2>Нужно так же?</h2>
            <p>Покажите нам свой процесс — за неделю найдём, где теряются часы и деньги.</p>
          </div>
          <div class="actions">
            <a class="button button-primary" href={contact} data-telegram-contact>Обсудить похожий проект</a>
          </div>
        </div>}
      </article>
      {related.length > 0 && <section class="section" aria-labelledby="case-related">
        <div class="section-head"><h2 id="case-related">Похожие проекты</h2></div>
        <div class="project-grid">{related.map((entry) => <ProjectCard project={entry} />)}</div>
      </section>}
    </SiteLayout>}
