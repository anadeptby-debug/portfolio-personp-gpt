---
import SiteLayout from '../layouts/SiteLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import { profile } from '../features/portfolio/data';
import { principles, stages } from '../features/portfolio/company';
import { telegramContact } from '../features/sharing/links';
import { catalogPath, withBase } from '../features/portfolio/routes';

const telegram = telegramContact(profile.telegramUsername);
const hasProfile = profile.displayName || profile.avatar || profile.bio || profile.headline || profile.competencies.length;
const hasContacts = telegram || profile.githubUrl || profile.email;
---
<SiteLayout title="О нас" description={profile.bio ?? 'Команда, подход и контакты.'} page="about">
  {hasProfile
    ? <section class="about-card" aria-label="Профиль">
        <img class="profile-mark" src={profile.avatar ? withBase(profile.avatar) : withBase('/portfolio-icon.png')} alt="" width="72" height="72" />
        <h1>{profile.displayName ?? 'О нас'}</h1>
        {profile.headline && <p>{profile.headline}</p>}
        {profile.availability === 'available' && <p class="availability"><span></span>Берём новые проекты</p>}
      </section>
    : <>
        <div class="page-heading"><h1>О нас</h1></div>
        <EmptyState title="Профиль пока не заполнен" href={catalogPath()} linkLabel="Смотреть проекты" />
      </>}

  {profile.bio && <section class="group" aria-labelledby="about-bio">
    <div class="group-head"><h2 id="about-bio">О компании</h2></div>
    <div class="group-body"><p class="long-copy">{profile.bio}</p></div>
  </section>}

  {hasContacts && <section class="group" aria-labelledby="about-contacts">
    <div class="group-head"><h2 id="about-contacts">Связаться</h2></div>
    <ul class="cells">
      {telegram && <li><a class="cell" href={telegram} data-telegram-contact>
        <span class="cell-icon" aria-hidden="true">✈</span>
        <span class="cell-body"><span class="cell-title">Написать в Telegram</span><span class="cell-sub">@{profile.telegramUsername}</span></span>
      </a></li>}
      {profile.email && <li><a class="cell" href={'mailto:' + profile.email}>
        <span class="cell-icon cell-icon-muted" aria-hidden="true">@</span>
        <span class="cell-body"><span class="cell-title">Почта</span><span class="cell-sub">{profile.email}</span></span>
      </a></li>}
      {profile.githubUrl && <li><a class="cell" href={profile.githubUrl}>
        <span class="cell-icon cell-icon-muted" aria-hidden="true">GH</span>
        <span class="cell-body"><span class="cell-title">GitHub</span></span>
      </a></li>}
    </ul>
  </section>}

  <section class="group" aria-labelledby="about-stages">
    <div class="group-head"><h2 id="about-stages">Как мы работаем</h2></div>
    <ol class="cells">
      {stages.map((stage, index) => <li class="cell">
        <span class="cell-icon cell-icon-muted" aria-hidden="true">{index + 1}</span>
        <span class="cell-body"><span class="cell-title">{stage.title}</span><span class="cell-sub">{stage.text}</span></span>
        <span class="cell-value">{stage.term}</span>
      </li>)}
    </ol>
    <p class="group-foot">Каждый этап — отдельный договор. После любого можно остановиться.</p>
  </section>

  <section class="group" aria-labelledby="about-principles">
    <div class="group-head"><h2 id="about-principles">Принципы</h2></div>
    <ul class="cells">
      {principles.map((item) => <li class="cell feature-cell">
        <span class="cell-body"><span class="cell-title">{item.title}</span><span class="cell-sub">{item.text}</span></span>
      </li>)}
    </ul>
  </section>

  {profile.competencies.length > 0 && <section class="group" aria-labelledby="about-skills">
    <div class="group-head"><h2 id="about-skills">С чем работаем</h2></div>
    <ul class="tags" aria-label="Компетенции">{profile.competencies.map((skill) => <li>{skill}</li>)}</ul>
  </section>}
</SiteLayout>
