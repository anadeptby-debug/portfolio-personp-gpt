---
import SiteLayout from '../layouts/SiteLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, publishedProjects } from '../features/portfolio/data';
import { catalogPath, categories, type Category } from '../features/portfolio/routes';
import { telegramContact } from '../features/sharing/links';

const projects = await publishedProjects();
const featured = projects.filter((project) => project.featured);
const selected = (featured.length ? featured : projects).slice(0, 5);
const activeCategories = (Object.keys(categories) as Category[])
  .filter((category) => projects.some((project) => project.categories.includes(category)));
const headline = profile.headline ?? 'Портфолио IT‑специалиста';
const contact = telegramContact(profile.telegramUsername);
---
<SiteLayout title={headline} description={profile.bio ?? 'Проекты и профиль IT-специалиста.'} page="home">
  <section class="hero">
    <div class="hero-content">
      {profile.displayName && <div class="identity">
        {profile.avatar
          ? <img src={profile.avatar} alt="" width="44" height="44" />
          : <span class="identity-placeholder" aria-hidden="true">{profile.displayName.slice(0, 1)}</span>}
        <span>{profile.displayName}</span>
      </div>}
      {profile.availability === 'available' && <p class="availability"><span></span>Открыт к проектам</p>}
      <h1>{headline}</h1>
      {profile.bio && <p class="hero-description">{profile.bio}</p>}
      <div class="actions">
        <a class="button button-primary" href="/projects">Смотреть проекты</a>
        {contact && <a class="button button-secondary" href={contact} data-telegram-contact>Обсудить проект</a>}
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <span class="hero-orbit orbit-one"></span>
      <span class="hero-orbit orbit-two"></span>
      <span class="hero-orbit orbit-three"></span>
      <span class="hero-orbit orbit-four"></span>
      <span class="hero-cross"></span>
      <span class="hero-node"></span>
    </div>
  </section>

  <section class="section" aria-labelledby="home-projects">
    <div class="section-head">
      <h2 id="home-projects">{featured.length ? 'Избранные проекты' : 'Проекты'}</h2>
      {selected.length > 0 && <a class="text-link" href="/projects">Все проекты</a>}
    </div>
    {selected.length
      ? <div class="project-grid">{selected.map((project) => <ProjectCard project={project} />)}</div>
      : <EmptyState title="Пока нет опубликованных проектов" heading="h3" />}
  </section>

  {activeCategories.length > 0 && <section class="section" aria-labelledby="home-categories">
    <div class="section-head"><h2 id="home-categories">Направления проектов</h2></div>
    <ul class="filters">
      {activeCategories.map((category) => <li><a href={catalogPath(category)}>{categories[category]}</a></li>)}
    </ul>
  </section>}
</SiteLayout>
