---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, publishedProjects } from '../features/portfolio/data';
import { services } from '../features/portfolio/company';
import { catalogPath, categories, projectPath, withBase } from '../features/portfolio/routes';
import { telegramContact } from '../features/sharing/links';

const projects = await publishedProjects();
const demos = projects.filter((project) => project.kind === 'demo' && project.demoUrl);
const cases = projects.filter((project) => !demos.includes(project));
const featured = cases.filter((project) => project.featured);
const selected = (featured.length ? featured : cases.length ? cases : projects).slice(0, 4);
// Три самые показательные цифры — по одной из первых кейсов с результатами.
const stats = cases.filter((project) => project.results.length).slice(0, 3)
  .map((project) => ({ ...project.results[0], href: projectPath(project.slug) }));
const directions = [...new Set(services.map((service) => service.category))]
  .filter((category) => projects.some((project) => project.categories.includes(category)));
const headline = profile.headline ?? 'Автоматизация и ИИ для бизнеса';
const contact = telegramContact(profile.telegramUsername);
const lead = profile.bio?.split('. ')[0];
---
<SiteLayout title={headline} description={profile.bio ?? 'Кейсы по автоматизации и внедрению ИИ.'} page="home">
  <section class="profile">
    <img class="profile-mark" src={withBase('/portfolio-icon.png')} alt="" width="56" height="56" />
    <div>
      <p class="profile-name">
        {profile.displayName ?? 'Anadept'}
        {profile.availability === 'available' && <span class="status" title="Берём новые проекты"></span>}
      </p>
      <h1>{headline}</h1>
    </div>
  </section>
  {lead && <p class="profile-lead">{lead.endsWith('.') ? lead : lead + '.'}</p>}

  {stats.length === 3 && <ul class="stats" aria-label="Результаты в цифрах">
    {stats.map(({ value, label, href }) => <li><a class="stat" href={href}><strong>{value}</strong><span>{label}</span></a></li>)}
  </ul>}

  {demos.length > 0 && <section class="group" aria-labelledby="home-demos">
    <div class="group-head"><h2 id="home-demos">Попробуйте сами</h2></div>
    <ul class="demo-strip">
      {demos.map((demo) => <li>
        <a class="demo-tile" href={withBase(demo.demoUrl!)}>
          {demo.cover && <Image src={demo.cover.image} alt="" widths={[320, 560]} sizes="17rem" />}
          <span class="demo-tile-body"><strong>{demo.shortTitle ?? demo.title}</strong><span>Открыть</span></span>
        </a>
      </li>)}
    </ul>
    <p class="group-foot">Интерактивные демо работают прямо здесь, на тестовых данных.</p>
  </section>}

  <section class="group" aria-labelledby="home-projects">
    <div class="group-head">
      <h2 id="home-projects">Кейсы</h2>
      {projects.length > selected.length && <a class="text-link" href={catalogPath()}>Все проекты</a>}
    </div>
    {selected.length
      ? <div class="project-grid">{selected.map((project) => <ProjectCard project={project} />)}</div>
      : <EmptyState title="Пока нет опубликованных проектов" heading="h3" />}
  </section>

  {directions.length > 0 && <section class="group" aria-labelledby="home-directions">
    <div class="group-head"><h2 id="home-directions">Направления</h2></div>
    <div class="chip-strip">
      <ul class="filters">
        {directions.map((category) => <li><a href={catalogPath(category)}>{categories[category]}</a></li>)}
      </ul>
    </div>
  </section>}

  {contact && <section class="group web-only" aria-label="Связаться">
    <a class="button button-primary button-block" href={contact} data-telegram-contact>Обсудить проект в Telegram</a>
    <p class="group-foot">Первая консультация бесплатно.</p>
  </section>}
</SiteLayout>
