---
import SiteLayout from '../layouts/SiteLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import { catalogPath } from '../features/portfolio/routes';
---
<SiteLayout title="Страница недоступна" description="Страница не найдена." page="not_found" noindex>
  <div class="page-heading"><h1>Страница недоступна</h1></div>
  <EmptyState title="Возможно, адрес изменился" description="Все доступные работы собраны в каталоге." href={catalogPath()} linkLabel="К проектам" />
</SiteLayout>
