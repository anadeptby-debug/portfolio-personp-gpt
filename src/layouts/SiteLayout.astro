---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { profile } from '../features/portfolio/data';
import { telegramContact } from '../features/sharing/links';

interface Props {
  title: string;
  description: string;
  page: 'home' | 'projects' | 'case' | 'about' | 'telegram' | 'not_found' | 'alias';
  canonicalPath?: string;
  previewImage?: { src: string; alt: string };
  noindex?: boolean;
}

const { title, description, page, canonicalPath, previewImage, noindex } = Astro.props;
const siteName = profile.displayName ? 'Портфолио · ' + profile.displayName : 'Портфолио';
const documentTitle = page === 'home' ? title : title + ' | ' + siteName;
const path = canonicalPath ?? (Astro.url.pathname.replace(/\/$/, '') || '/');
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
const openGraphImage = previewImage ?? { src: '/portfolio-preview.png', alt: 'Портфолио IT-специалиста' };
const imageUrl = Astro.site ? new URL(openGraphImage.src, Astro.site).href : undefined;
const contact = telegramContact(profile.telegramUsername);
const navigation = [
  { key: 'home', href: '/', label: 'Главная' },
  { key: 'projects', href: '/projects', label: 'Проекты' },
  { key: 'about', href: '/about', label: 'Обо мне' },
] as const;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/portfolio-icon.png" type="image/png" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {!noindex && <>
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:type" content={page === 'case' ? 'article' : 'website'} />
      <meta property="og:site_name" content={siteName} />
      <meta property="og:locale" content="ru_RU" />
      {canonical && <meta property="og:url" content={canonical} />}
      {imageUrl && <meta property="og:image" content={imageUrl} />}
      {imageUrl && <meta property="og:image:alt" content={openGraphImage.alt} />}
    </>}
    <slot name="head" />
    <ClientRouter fallback="swap" />
  </head>
  <body data-page={page} transition:animate="none">
    <a class="skip-link" href="#main-content">К содержанию</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>{profile.displayName ?? 'Портфолио'}</span>
        </a>
        <nav class="site-nav" aria-label="Основная навигация">
          {navigation.map(({ key, href, label }) => (
            <a href={href} aria-current={page === key ? 'page' : page === 'case' && key === 'projects' ? 'location' : undefined}>
              <span class:list={['nav-icon', 'nav-icon-' + key]} aria-hidden="true"></span>
              {label}
            </a>
          ))}
        </nav>
        {contact && <a class="button button-small header-contact" href={contact} data-telegram-contact>Написать в Telegram</a>}
      </div>
    </header>
    <main class="container site-main" id="main-content" tabindex="-1">
      <slot />
    </main>
    {contact && <footer class="site-footer">
      <div class="container footer-inner">
        <span>{siteName}</span>
        <a href={contact} data-telegram-contact>Telegram</a>
      </div>
    </footer>}
    <script>
      import '../features/app';
    </script>
  </body>
</html>
